<?xml version="1.0" encoding="utf-8"?>
<!-- 기기 백업·기기 간 옮기기에서 로그인 토큰(account.xml)은 뺀다. 옮긴 기기에서는 다시 로그인한다 (Android 12 이상) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
