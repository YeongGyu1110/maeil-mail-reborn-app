<?xml version="1.0" encoding="utf-8"?>
<!-- 한 칸 높이 위젯: 오늘의 질문 번호와 제목만 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/widget_dot" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_bold"
                android:letterSpacing="-0.015"
                android:maxLines="1"
                android:text="@string/widget_label"
                android:textColor="@color/widget_text_main"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_bold"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/widget_text_main"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
