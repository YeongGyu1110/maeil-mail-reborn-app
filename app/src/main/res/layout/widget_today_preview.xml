<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르기 화면에 보일 예시 (widget_today.xml과 같은 모양) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/widget_dot" />

        <TextView
            android:id="@+id/widget_preview_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="-0.015"
            android:maxLines="1"
            android:text="@string/widget_label"
            android:textColor="@color/widget_text_main"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:text="FE-1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_rule" />

    <TextView
        android:text="@string/widget_preview_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="3"
        android:textColor="@color/widget_text_main"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:text="@string/widget_preview_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="12.5sp" />
</LinearLayout>
