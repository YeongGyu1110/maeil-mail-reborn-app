<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르기 화면에 보일 예시 (widget_today.xml과 같은 모양) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/widget_dot" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_bold"
                android:letterSpacing="-0.015"
                android:maxLines="1"
                android:text="@string/widget_label"
                android:textColor="@color/widget_text_main"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="FE-1"
                android:textColor="@color/widget_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_bold"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:text="@string/widget_preview_title"
            android:textColor="@color/widget_text_main"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_regular"
            android:maxLines="1"
            android:text="@string/widget_preview_sub"
            android:textColor="@color/widget_text_muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_received_cell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_received"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="57"
                android:textColor="@color/widget_text_main"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:letterSpacing="-0.015"
                android:maxLines="1"
                android:text="@string/widget_received"
                android:textColor="@color/widget_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_rule" />

        <LinearLayout
            android:id="@+id/widget_review_cell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="11"
                android:textColor="@color/widget_text_main"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:letterSpacing="-0.015"
                android:maxLines="1"
                android:text="@string/widget_review"
                android:textColor="@color/widget_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_rule" />

        <LinearLayout
            android:id="@+id/widget_starred_cell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_starred"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="3"
                android:textColor="@color/widget_text_main"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:letterSpacing="-0.015"
                android:maxLines="1"
                android:text="@string/widget_starred"
                android:textColor="@color/widget_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
