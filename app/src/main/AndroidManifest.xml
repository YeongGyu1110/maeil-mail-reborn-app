<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 웹 서비스 저장소(GitHub)에서 질문과 발송 기록을 받는다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 오늘의 질문 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 정한 시각에 정확히 알린다 (개인용 앱: 설치할 때 저절로 허용되는 USE_EXACT_ALARM을 쓴다) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- 재부팅 뒤 알림을 다시 건다 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 설정에서 배터리 최적화 예외를 요청한다 (절전 중에도 알림이 늦지 않게) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaeilMail">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 웹 서비스 주소(메일의 "답변 확인하기" 버튼 등)를 앱에서 연다 (앱 링크). 이 호스트 전체가 웹 서비스다.
                 질문 화면 주소면 그 질문을, 그 밖의 주소면 앱 첫 화면을 연다. data/WebLink.kt 참고 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="maeil-mail-reborn.pages.dev" />
            </intent-filter>
            <!-- (레거시) 2026-11-23까지 받은 메일의 옛 주소(GitHub Pages). 이 호스트에는 증명 파일이 없어 검증하지 않고(autoVerify 없음),
                 사용자가 휴대폰 설정의 "지원되는 웹 주소"에서 직접 켜야 앱으로 열린다. 개인 사이트의 다른 페이지는 받지 않는다 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="yeonggyu1110.github.io" />
                <data android:pathPrefix="/maeil-mail-reborn/" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 위젯: 오늘의 질문 -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
